# Copy this file to .env and fill in your local values.

KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret

OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/oauth/success
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_URL=jdbc:mariadb://localhost:3306/oao
DB_USERNAME=oao
DB_PASSWORD=oao
SPRING_DOCKER_COMPOSE_ENABLED=false

# Explicit public URLs for OAuth, cookies, WebSocket origins and payment callbacks.
KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao
APP_FRONTEND_URL=http://localhost:3000

# Email authentication (Amazon SES). Production EC2 uses its attached IAM role.
AWS_SES_REGION=ap-northeast-2
EMAIL_FROM=LoveCatcher <hello@oao365.com>

# SMS verification (SOLAPI). Keep mock only for local development.
VERIFICATION_MESSAGE_PROVIDER=mock
VERIFICATION_DEV_CODE_RESPONSE_ENABLED=false
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM_NUMBER=

# Kakao Alimtalk: registered channel and three approved templates.
ALIMTALK_ENABLED=false
ALIMTALK_PF_ID=
ALIMTALK_MATCH_TEMPLATE_ID=
ALIMTALK_EXPRESS_TEMPLATE_ID=
ALIMTALK_COMPLETED_TEMPLATE_ID=

# Toss Payments v2 payment window keys (same merchant and environment).
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=

# First-run administrator bootstrap. Remove the password after creation.
OAO_ADMIN_BOOTSTRAP_EMAIL=
OAO_ADMIN_BOOTSTRAP_PASSWORD=
OAO_ADMIN_BOOTSTRAP_NAME=관리자

# Persistent public photos; private verification is a sibling directory.
UPLOAD_ROOT_DIR=uploads
UPLOAD_PUBLIC_PATH=/uploads

# Never enable development account overrides in production.
OAO_DEV_TOOLS_ENABLED=false
OAO_DEV_TOOLS_SECRET=
